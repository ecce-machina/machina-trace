#!/usr/bin/env bash
set -euo pipefail

VERSION="0.0.1"

snapshot() {
    echo "machina-trace snapshot"
    echo

    echo "== Lustre mounts =="
    if ! mount | grep -E 'type lustre'; then
        echo "No Lustre mounts found"
    fi

    echo
    echo "== Lustre stats files =="
    find /proc/fs/lustre \( -name stats -o -name md_stats \) -type f 2>/dev/null | sort || true

    echo
    echo "== Lustre metadata stats =="
    for f in $(find /proc/fs/lustre -name md_stats -type f 2>/dev/null | sort); do
        echo "--- $f ---"
        cat "$f"
        echo
    done
}

case "${1:-help}" in
    snapshot)
        snapshot
        ;;
    version)
        echo "$VERSION"
        ;;
    help|--help|-h)
        echo "Usage:"
        echo "  machina-trace snapshot"
        echo "  machina-trace version"
        ;;
    *)
        echo "Unknown command: $1" >&2
        echo "Try: machina-trace help" >&2
        exit 1
        ;;
esac
